--[[
Pano Align Fuse for Blackmagic Fusion
Aligns 360 degree equirectangular/latlong panoramic images

This tool allows you to define two vertical reference lines in your panorama
by dragging points in the viewer. The tool calculates the pitch and roll
needed to align the image properly.

Usage:
1. Connect your 360 latlong image
2. Drag the on-screen points to define two vertical lines
   (choose features that should be vertical in real world)
3. Click "Apply" button to calculate and apply alignment
4. Use Manual Offsets to fine-tune (additive to calculated values)
5. Click "Reset Offsets" to clear manual adjustments

Author: Created for panoramic image alignment
Version: 4.0
]]--

FuRegisterClass("PanoAlign", CT_Tool, {
    REGS_Name = "Pano Align",
    REGS_Category = "Transform",
    REGS_OpIconString = "PA",
    REGS_OpDescription = "Align 360 degree panoramic images by defining two vertical references",
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

function Create()
    -- Input image
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Vertical Line 1
    self:BeginControlNest("Vertical Line 1", "VertLine1", true, {})

    InVert1Point1 = self:AddInput("Top Point", "Vert1Point1", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.3,
        INP_DefaultY = 0.2,
    })

    InVert1Point2 = self:AddInput("Bottom Point", "Vert1Point2", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.3,
        INP_DefaultY = 0.8,
    })

    self:EndControlNest()

    -- Vertical Line 2
    self:BeginControlNest("Vertical Line 2", "VertLine2", true, {})

    InVert2Point1 = self:AddInput("Top Point", "Vert2Point1", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.7,
        INP_DefaultY = 0.2,
    })

    InVert2Point2 = self:AddInput("Bottom Point", "Vert2Point2", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.7,
        INP_DefaultY = 0.8,
    })

    self:EndControlNest()

    -- Calculated values display
    self:BeginControlNest("Calculated from Lines", "CalcDisplay", true, {})

    InCalcInfoLabel = self:AddInput("Values", "CalcInfoLabel", {
        LINKID_DataType = "Text",
        INPID_InputControl = "LabelControl",
        INP_External = false,
        INP_Passive = true,
        ICD_Width = 1,
    })

    self:EndControlNest()

    -- Manual adjustment offsets (additive)
    self:BeginControlNest("Manual Offsets (Additive)", "ManualOffsets", true, {})

    InPitchOffset = self:AddInput("Pitch Offset", "PitchOffset", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -45.0,
        INP_MaxScale = 45.0,
    })

    InYawOffset = self:AddInput("Yaw Offset", "YawOffset", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -90.0,
        INP_MaxScale = 90.0,
    })

    InRollOffset = self:AddInput("Roll Offset", "RollOffset", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -45.0,
        INP_MaxScale = 45.0,
    })

    InFinalInfoLabel = self:AddInput("Final Values", "FinalInfoLabel", {
        LINKID_DataType = "Text",
        INPID_InputControl = "LabelControl",
        INP_External = false,
        INP_Passive = true,
        ICD_Width = 1,
    })

    InApplyButton = self:AddInput("Apply", "ApplyButton", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_DoNotifyChanged = true,
        INP_External = false,
    })

    InResetButton = self:AddInput("Reset Offsets", "ResetButton", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_DoNotifyChanged = true,
        INP_External = false,
    })

    InResetPointsButton = self:AddInput("Reset Points", "ResetPointsButton", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_DoNotifyChanged = true,
        INP_External = false,
    })

    self:EndControlNest()

    -- Internal flag to track if Apply has been clicked
    InApplied = self:AddInput("Applied", "Applied", {
        LINKID_DataType = "Number",
        INP_Default = 0,
        INP_Integer = true,
        IC_Visible = false,
    })

    -- Stored calculated angles (set when Apply is clicked)
    InStoredPitch = self:AddInput("Stored Pitch", "StoredPitch", {
        LINKID_DataType = "Number",
        INP_Default = 0,
        IC_Visible = false,
    })

    InStoredYaw = self:AddInput("Stored Yaw", "StoredYaw", {
        LINKID_DataType = "Number",
        INP_Default = 0,
        IC_Visible = false,
    })

    InStoredRoll = self:AddInput("Stored Roll", "StoredRoll", {
        LINKID_DataType = "Number",
        INP_Default = 0,
        IC_Visible = false,
    })

    -- Processing options
    InShowOverlay = self:AddInput("Show Reference Lines", "ShowOverlay", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Default = 1.0,
        INP_Integer = true,
    })

    -- Output
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Information outputs
    OutPitch = self:AddOutput("Calculated Pitch", "CalcPitch", {
        LINKID_DataType = "Number",
        LINK_Main = 2,
    })

    OutYaw = self:AddOutput("Calculated Yaw", "CalcYaw", {
        LINKID_DataType = "Number",
        LINK_Main = 3,
    })

    OutRoll = self:AddOutput("Calculated Roll", "CalcRoll", {
        LINKID_DataType = "Number",
        LINK_Main = 4,
    })
end

function NotifyChanged(inp, param, time)
    if inp == InApplyButton then
        -- Set the Applied flag to trigger correction
        -- Use the correct Fusion API: SetSource(Number(value), time)
        InApplied:SetSource(Number(1), time)
    elseif inp == InResetButton then
        -- Reset all offsets to zero using correct API
        InPitchOffset:SetSource(Number(0), time)
        InYawOffset:SetSource(Number(0), time)
        InRollOffset:SetSource(Number(0), time)
    elseif inp == InResetPointsButton then
        -- Reset all points to default positions
        InVert1Point1:SetSource(Point(0.3, 0.2), time)
        InVert1Point2:SetSource(Point(0.3, 0.8), time)
        InVert2Point1:SetSource(Point(0.7, 0.2), time)
        InVert2Point2:SetSource(Point(0.7, 0.8), time)
    end
end

-- Convert normalized coordinates to spherical (lon, lat) for equirectangular
function NormalizedToSpherical(x, y)
    local lon = (x - 0.5) * 360.0  -- -180 to 180
    local lat = (0.5 - y) * 180.0  -- 90 to -90
    return lon, lat
end

-- Convert spherical coordinates to 3D unit vector
function SphericalToVector(lon, lat)
    local lonRad = math.rad(lon)
    local latRad = math.rad(lat)

    local x = math.cos(latRad) * math.sin(lonRad)
    local y = math.sin(latRad)
    local z = math.cos(latRad) * math.cos(lonRad)

    return {x = x, y = y, z = z}
end

-- Vector operations
function VectorLength(v)
    return math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
end

function VectorNormalize(v)
    local len = VectorLength(v)
    if len > 0.0001 then
        return {x = v.x / len, y = v.y / len, z = v.z / len}
    end
    return {x = 0, y = 1, z = 0}
end

function VectorCross(a, b)
    return {
        x = a.y * b.z - a.z * b.y,
        y = a.z * b.x - a.x * b.z,
        z = a.x * b.y - a.y * b.x
    }
end

function VectorDot(a, b)
    return a.x * b.x + a.y * b.y + a.z * b.z
end

-- Calculate alignment angles from two vertical reference lines
function CalculateAlignmentFromVerticals(v1x1, v1y1, v1x2, v1y2, v2x1, v2y1, v2x2, v2y2)
    -- SIMPLIFIED: Return zero values for now
    -- We'll rebuild the calculation step by step
    local yaw = 0
    local pitch = 0
    local roll = 0

    return yaw, pitch, roll
end

function Process(req)
    local img = InImage:GetValue(req)
    local showOverlay = InShowOverlay:GetValue(req).Value == 1
    local applied = InApplied:GetValue(req).Value == 1

    if not img then
        return
    end

    -- Get point coordinates
    local v1p1 = InVert1Point1:GetValue(req)
    local v1p2 = InVert1Point2:GetValue(req)
    local v2p1 = InVert2Point1:GetValue(req)
    local v2p2 = InVert2Point2:GetValue(req)

    -- Extract X and Y from Point objects
    local v1x1, v1y1 = v1p1.X, v1p1.Y
    local v1x2, v1y2 = v1p2.X, v1p2.Y
    local v2x1, v2y1 = v2p1.X, v2p1.Y
    local v2x2, v2y2 = v2p2.X, v2p2.Y

    local result = img

    -- Variables to hold the angles to use for transformation
    local calcYaw, calcPitch, calcRoll

    -- If Apply button was just clicked, calculate and store angles
    if applied then
        -- Calculate values from reference lines
        calcYaw, calcPitch, calcRoll = CalculateAlignmentFromVerticals(
            v1x1, v1y1, v1x2, v1y2,
            v2x1, v2y1, v2x2, v2y2
        )

        -- Store the calculated angles for future frames
        -- Note: SetSource is asynchronous and won't take effect until next frame
        InStoredYaw:SetSource(Number(calcYaw), req.Time)
        InStoredPitch:SetSource(Number(calcPitch), req.Time)
        InStoredRoll:SetSource(Number(calcRoll), req.Time)

        -- Update calculated values label (order: Yaw, Pitch, Roll)
        local calcLabelText = string.format("Yaw: %.2f°  Pitch: %.2f°  Roll: %.2f°", calcYaw, calcPitch, calcRoll)
        InCalcInfoLabel:SetAttrs({LINKS_Name = calcLabelText})

        -- Output calculated values
        OutYaw:Set(req, calcYaw)
        OutPitch:Set(req, calcPitch)
        OutRoll:Set(req, calcRoll)

        -- Reset the Applied flag
        InApplied:SetSource(Number(0), req.Time)
    else
        -- Not currently applying, so use stored angles from previous Apply
        calcYaw = InStoredYaw:GetValue(req).Value
        calcPitch = InStoredPitch:GetValue(req).Value
        calcRoll = InStoredRoll:GetValue(req).Value

        -- Update label to show current stored values (order: Yaw, Pitch, Roll)
        local calcLabelText = string.format("Yaw: %.2f°  Pitch: %.2f°  Roll: %.2f°", calcYaw, calcPitch, calcRoll)
        InCalcInfoLabel:SetAttrs({LINKS_Name = calcLabelText})

        -- Output stored values
        OutYaw:Set(req, calcYaw)
        OutPitch:Set(req, calcPitch)
        OutRoll:Set(req, calcRoll)
    end

    -- Get manual offsets
    local yawOffset = InYawOffset:GetValue(req).Value
    local pitchOffset = InPitchOffset:GetValue(req).Value
    local rollOffset = InRollOffset:GetValue(req).Value

    -- Calculate final values (calculated/stored + offsets)
    local finalYaw = calcYaw + yawOffset
    local finalPitch = calcPitch + pitchOffset
    local finalRoll = calcRoll + rollOffset

    -- Update final values label (order: Yaw, Pitch, Roll)
    local finalLabelText = string.format("Yaw: %.2f°  Pitch: %.2f°  Roll: %.2f°", finalYaw, finalPitch, finalRoll)
    InFinalInfoLabel:SetAttrs({LINKS_Name = finalLabelText})

    -- Apply transformation only when values are non-zero
    -- Yaw is NOT negated to match standard panorama convention
    if finalYaw ~= 0 or finalPitch ~= 0 or finalRoll ~= 0 then
        result = ApplyPanoCorrection(img, finalYaw, -finalPitch, -finalRoll, req)
    end

    -- Add overlay if requested (always draw on current result)
    if showOverlay then
        result = AddOverlay(result, v1x1, v1y1, v1x2, v1y2, v2x1, v2y1, v2x2, v2y2,
                          false, 0, 0, 0, req)
    end

    OutImage:Set(req, result)
end

-- Apply panoramic correction using pixel-by-pixel transformation
function ApplyPanoCorrection(img, yaw, pitch, roll, req)
    local width = img.Width
    local height = img.Height

    -- Create output image
    local out = Image({
        IMG_Like = img,
        IMG_Width = width,
        IMG_Height = height,
    })

    -- Convert angles to radians
    local yawRad = math.rad(yaw)
    local pitchRad = math.rad(pitch)
    local rollRad = math.rad(roll)

    -- Precompute trig values
    local cosPitch = math.cos(pitchRad)
    local sinPitch = math.sin(pitchRad)
    local cosYaw = math.cos(yawRad)
    local sinYaw = math.sin(yawRad)
    local cosRoll = math.cos(rollRad)
    local sinRoll = math.sin(rollRad)

    -- Process each pixel
    local srcPixel = Pixel()

    for y = 0, height - 1 do
        for x = 0, width - 1 do
            -- Convert pixel to normalized coordinates [0,1]
            local nx = x / width
            local ny = y / height

            -- Convert to spherical coordinates (longitude, latitude in degrees)
            local lon = (nx - 0.5) * 360.0  -- -180 to 180
            local lat = (0.5 - ny) * 180.0  -- 90 to -90

            -- Convert to radians
            local lonRad = math.rad(lon)
            local latRad = math.rad(lat)

            -- Convert to 3D unit vector
            local vx = math.cos(latRad) * math.sin(lonRad)
            local vy = math.sin(latRad)
            local vz = math.cos(latRad) * math.cos(lonRad)

            -- Apply rotations in order: Yaw, Pitch, Roll
            -- Yaw (around Y axis)
            local x1 = vx * cosYaw + vz * sinYaw
            local y1 = vy
            local z1 = -vx * sinYaw + vz * cosYaw

            -- Pitch (around X axis)
            local x2 = x1
            local y2 = y1 * cosPitch - z1 * sinPitch
            local z2 = y1 * sinPitch + z1 * cosPitch

            -- Roll (around Z axis)
            local x3 = x2 * cosRoll - y2 * sinRoll
            local y3 = x2 * sinRoll + y2 * cosRoll
            local z3 = z2

            -- Convert back to spherical
            local newLon = math.deg(math.atan2(x3, z3))
            local newLat = math.deg(math.asin(math.max(-1, math.min(1, y3))))

            -- Convert back to normalized coordinates
            local newNx = newLon / 360.0 + 0.5
            local newNy = 0.5 - newLat / 180.0

            -- Wrap horizontally (longitude wraps around)
            newNx = newNx - math.floor(newNx)

            -- Clamp vertically (latitude doesn't wrap)
            newNy = math.max(0, math.min(1, newNy))

            -- Convert to pixel coordinates
            local srcX = newNx * width
            local srcY = newNy * height

            -- Sample from source image (bilinear interpolation)
            img:SamplePixel(srcX, srcY, srcPixel)
            out:SetPixel(x, y, srcPixel)
        end
    end

    return out
end

-- Transform a normalized coordinate through the rotation
function TransformPoint(nx, ny, yaw, pitch, roll)
    -- Convert to spherical coordinates
    local lon = (nx - 0.5) * 360.0
    local lat = (0.5 - ny) * 180.0

    -- Convert to 3D vector
    local vec = SphericalToVector(lon, lat)

    -- Convert angles to radians
    local yawRad = math.rad(yaw)
    local pitchRad = math.rad(pitch)
    local rollRad = math.rad(roll)

    local cosPitch = math.cos(pitchRad)
    local sinPitch = math.sin(pitchRad)
    local cosYaw = math.cos(yawRad)
    local sinYaw = math.sin(yawRad)
    local cosRoll = math.cos(rollRad)
    local sinRoll = math.sin(rollRad)

    -- Apply rotation in correct order: Yaw, Pitch, Roll
    -- Yaw (around Y axis) - applied first
    local x1 = vec.x * cosYaw + vec.z * sinYaw
    local y1 = vec.y
    local z1 = -vec.x * sinYaw + vec.z * cosYaw

    -- Pitch (around X axis) - applied second
    local x2 = x1
    local y2 = y1 * cosPitch - z1 * sinPitch
    local z2 = y1 * sinPitch + z1 * cosPitch

    -- Roll (around Z axis) - applied last
    local x3 = x2 * cosRoll - y2 * sinRoll
    local y3 = x2 * sinRoll + y2 * cosRoll
    local z3 = z2

    -- Convert back to spherical
    local newLon = math.deg(math.atan2(x3, z3))
    local newLat = math.deg(math.asin(math.max(-1, math.min(1, y3))))

    -- Convert back to normalized coordinates
    local newNx = newLon / 360.0 + 0.5
    local newNy = 0.5 - newLat / 180.0

    return newNx, newNy
end

-- Add visual overlay showing reference lines
-- Lines are always drawn at the original point positions to match the on-screen markers
function AddOverlay(img, v1x1, v1y1, v1x2, v1y2, v2x1, v2y1, v2x2, v2y2,
                   applied, pitch, yaw, roll, req)
    local width = img.Width
    local height = img.Height

    -- Create a copy of the image
    local out = img:CopyOf()

    -- Draw lines at original positions (don't transform them)
    -- This ensures they align with the on-screen point markers

    -- Draw vertical line 1 (green) with antialiasing
    DrawLineAA(out,
        v1x1 * width, v1y1 * height,
        v1x2 * width, v1y2 * height,
        {R = 0.0, G = 1.0, B = 0.0, A = 1.0}, 2)

    -- Draw vertical line 2 (cyan) with antialiasing
    DrawLineAA(out,
        v2x1 * width, v2y1 * height,
        v2x2 * width, v2y2 * height,
        {R = 0.0, G = 1.0, B = 1.0, A = 1.0}, 2)

    return out
end

-- Antialiased line drawing with thickness
function DrawLineAA(img, x1, y1, x2, y2, color, thickness)
    thickness = thickness or 1
    x1 = math.floor(x1)
    y1 = math.floor(y1)
    x2 = math.floor(x2)
    y2 = math.floor(y2)

    local dx = math.abs(x2 - x1)
    local dy = math.abs(y2 - y1)
    local sx = x1 < x2 and 1 or -1
    local sy = y1 < y2 and 1 or -1
    local err = dx - dy

    local lineColor = Pixel(color)
    local srcPixel = Pixel()

    while true do
        -- Draw with thickness by drawing perpendicular to line direction
        for t = -thickness, thickness do
            local px, py
            if dx > dy then
                -- More horizontal, expand vertically
                px = x1
                py = y1 + t
            else
                -- More vertical, expand horizontally
                px = x1 + t
                py = y1
            end

            if px >= 0 and px < img.Width and py >= 0 and py < img.Height then
                -- Simple alpha blending for smoother edges
                local alpha = 1.0 - (math.abs(t) / (thickness + 1))
                img:GetPixel(px, py, srcPixel)

                local blended = Pixel({
                    R = srcPixel.R * (1 - alpha) + lineColor.R * alpha,
                    G = srcPixel.G * (1 - alpha) + lineColor.G * alpha,
                    B = srcPixel.B * (1 - alpha) + lineColor.B * alpha,
                    A = 1.0
                })
                img:SetPixel(px, py, blended)
            end
        end

        if x1 == x2 and y1 == y2 then break end

        local e2 = 2 * err
        if e2 > -dy then
            err = err - dy
            x1 = x1 + sx
        end
        if e2 < dx then
            err = err + dx
            y1 = y1 + sy
        end
    end
end
